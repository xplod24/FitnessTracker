{
  "info": {
    "name": "FitnessTracker Users API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Users",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8080/v1/users", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users" ] } }
    },
    {
      "name": "Get Simple Users",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8080/v1/users/simple", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "simple" ] } }
    },
    {
      "name": "Get User By ID",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8080/v1/users/1", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "1" ] } }
    },
    {
      "name": "Find Users by Email",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8080/v1/users/email?email=domain.com", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "email" ], "query": [ { "key": "email", "value": "domain.com" } ] } }
    },
    {
      "name": "Find Older Than",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8080/v1/users/older/2000-01-01", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "older", "2000-01-01" ] } }
    },
    {
      "name": "Create User",
      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jan\",\n  \"lastName\": \"Kowalski\",\n  \"birthdate\": \"1990-05-15\",\n  \"email\": \"jan.kowalski@domain.com\"\n}" }, "url": { "raw": "http://localhost:8080/v1/users", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users" ] } }
    },
    {
      "name": "Update User",
      "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Janina\",\n  \"lastName\": \"Kowalska\",\n  \"birthdate\": \"1990-05-15\",\n  \"email\": \"janina@domain.com\"\n}" }, "url": { "raw": "http://localhost:8080/v1/users/1", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "1" ] } }
    },
    {
      "name": "Delete User",
      "request": { "method": "DELETE", "url": { "raw": "http://localhost:8080/v1/users/1", "protocol": "http", "host": [ "localhost" ], "port": "8080", "path": [ "v1", "users", "1" ] } }
    }
  ]
}